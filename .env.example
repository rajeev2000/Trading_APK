# Public app configuration only. Values prefixed EXPO_PUBLIC_ are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Never put service-role keys, AI API keys, OAuth client secrets or refresh tokens here.
# Configure those only in Supabase Edge Function secrets after the provider/auth design is approved.
